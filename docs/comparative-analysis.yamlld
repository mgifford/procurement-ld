"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "region": "https://example.org/regions#"

"@id": "https://example.org/procurement-comparative-analysis"
"@type": "Dataset"
"name": "Global Procurement Policy Comparative Analysis (2026)"

"regions":
  - "@id": "region:UK"
    "name": "United Kingdom"
    "focus": "Social Value, Post-Brexit Reform, Digital Capability"
    "unique_policies":
      - "name": "Procurement Act 2023"
      - "name": "Social Value Act 2012"
      - "name": "Sourcing Playbook"

  - "@id": "region:EU"
    "name": "European Union"
    "focus": "Open Markets, Sustainability, Regulatory Compliance"

  - "@id": "region:USA"
    "name": "United States"
    "focus": "Domestic Preference, Cybersecurity, RFO Principle-based shift"
    "unique_policies":
      - "name": "Buy American Act"
      - "name": "FedRAMP / Cybersecurity Mandates"

  - "@id": "region:Canada"
    "name": "Canada"
    "focus": "Indigenous Participation, Socio-Economic Outcomes, Best Value"
    "unique_policies":
      - "name": "Directive on the Management of Procurement (TBS)"
        "description": "Ensures best value to the Crown while demonstrating stewardship of socio-economic objectives."
      - "name": "5% Indigenous Procurement Target"
        "description": "Mandatory requirement that 5% of federal contracts go to Indigenous businesses."
      - "name": "CFTA (Canadian Free Trade Agreement)"
        "description": "Internal trade rules prioritizing performance-based technical specifications (Article 509)."
      - "name": "Canadian Value-Added"
        "description": "Preference for domestic value-added in evaluation, typically up to 10% premium (CFTA 503.4)."

  - "@id": "region:NewZealand"
    "name": "New Zealand"
    "focus": "Māori Economy, Social Outcomes"
    "unique_policies":
      - "name": "Te Kupenga Hao Pāuaua"
        "description": "Progressive policy to support the Māori economy through social procurement."

"cross_regional_themes":
  - "theme": "Indigenous/First Nations Inclusion"
    "canada": "5% Mandatory Target"
    "australia": "Indigenous Procurement Policy (IPP)"
    "nz": "Te Kupenga Hao Pāuaua"
