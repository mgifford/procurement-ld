"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "region": "https://example.org/regions#"

"@id": "https://example.org/procurement-comparative-analysis"
"@type": "Dataset"
"name": "Global Procurement Policy Comparative Analysis (2026)"

"regions":
  - "@id": "region:UK"
    "name": "United Kingdom"
    "focus": "Social Value, Post-Brexit Reform, Digital Capability"
    "unique_policies":
      - "name": "Procurement Act 2023"
        "description": "Consolidated and simplified regime replacing EU-derived rules."
      - "name": "Social Value Act 2012"
        "description": "Mandatory consideration of social/environmental/economic impact."
      - "name": "Sourcing Playbook"
        "description": "Key guidance for complex projects, outsourcing, and insourcing decisions."
    "digital_authority": "Central Digital and Data Office (CDDO)"

  - "@id": "region:EU"
    "name": "European Union"
    "focus": "Open Markets, Sustainability, Regulatory Compliance"

  - "@id": "region:USA"
    "name": "United States"
    "focus": "Domestic Preference, Cybersecurity, RFO Principle-based shift"

"cross_regional_themes":
  - "theme": "Agile Readiness"
    "uk": "High (Competitive Flexible Procedure)"
    "usa": "High (TechFAR Hub / RFO discretionary power)"
    "eu": "Moderate (Standardized MEAT frameworks)"
