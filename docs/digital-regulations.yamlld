"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "far": "https://www.acquisition.gov/far/"
  "tfh": "https://techfarhub.usds.gov/"

"@id": "https://example.org/procurement-digital-regulations"
"@type": "Dataset"
"name": "Digital Procurement Regulations & Agile Frameworks (2026)"

"digital_service_definition":
  - "name": "Digital Services (USDS)"
    "components":
      - "Agile design and delivery"
      - "User research and user-centered design"
      - "Product management"
      - "API development"
      - "Automated testing"
      - "Cloud infrastructure management"
      - "CI/CD & DevOps"
    "context": "Defined in TechFAR Hub 'Get Started'."

"regulatory_mandates":
  - "@id": "far:Threshold_13_500"
    "name": "FAC-C (Professional) Mandatory DITAP"
    "requirement": "Required for professionals assigned to digital service acquisitions over FAR 13.500(c) thresholds."
    "credential": "FAC-C-Digital Services (FAC-C-DS)"

"usa_frameworks":
  - "@id": "far:Part39"
    "name": "FAR Part 39 - Acquisition of ICT"
  - "@id": "tfh:lifecycle"
    "name": "TechFAR Hub Agile Lifecycle"
    "stages":
      - "Pre-Solicitation (Agile Team, Market Research)"
      - "Solicitation (Contract Design, 8(a) Initiative)"
      - "Evaluation (Demo-based, Comparative Analysis)"
      - "Administration (Agile QA, Course Correction)"

"special_initiatives":
  - "name": "8(a) Digital Service Initiative"
    "description": "USDS & SBA partnership for low-risk gateway to small/diverse digital providers."
