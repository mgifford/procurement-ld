"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "uk": "https://www.gov.uk/"

"@id": "https://example.org/procurement-digital-regulations"
"@type": "Dataset"
"name": "Digital Procurement Regulations: US & UK Comparison (2026)"

"uk_frameworks":
  - "@id": "uk:TCoP"
    "name": "Technology Code of Practice (TCoP)"
    "description": "13-point standard for designing, building, and buying technology in government."
    "key_points":
      - "1. Define user needs"
      - "2. Make things accessible and inclusive"
      - "3. Be open and use open source"
      - "4. Make use of open standards"
      - "5. Use cloud first"
      - "11. Define your purchasing strategy (Modular/Agile preference)"

  - "@id": "uk:ProcurementAct2023"
    "name": "Procurement Act 2023"
    "effective": "February 2025"
    "reform_goals":
      - "Competitive Flexible Procedure: Allows buyers to adapt processes to the market."
      - "Central Digital Platform: Unified registration and tender access."
      - "Removing SME Barriers: Explicit mandate to consider and reduce barriers for smaller providers."

"digital_standards_comparison":
  - "theme": "Openness"
    "usa": "Encouraged through RFO and TechFAR guidance."
    "uk": "Mandatory via TCoP point 3 (Open Source) and 4 (Open Standards)."
  - "theme": "Cloud"
    "usa": "FedRAMP certification focus."
    "uk": "Cloud First policy (evaluate cloud solutions before all other options)."
  - "theme": "Modularity"
    "usa": "Modular Contracting (FAR 39.002)."
    "uk": "Lean Sourcing and 'Red Lines' (IT contracts capped at £100m)."
