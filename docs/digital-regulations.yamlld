"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "far": "https://www.acquisition.gov/far/"
  "tfh": "https://techfarhub.usds.gov/"
  "tbs": "https://www.tbs-sct.canada.ca/"

"@id": "https://example.org/procurement-digital-regulations"
"@type": "Dataset"
"name": "Digital Procurement Regulations: Global Comparison (2026)"

"usa_frameworks":
  - "@id": "far:Part39"
    "name": "FAR Part 39 - Acquisition of ICT"
    "elements": ["Modular Contracting", "Section 508 Accessibility"]
  - "@id": "tfh:lifecycle"
    "name": "TechFAR Hub Agile Lifecycle"
    "phases": ["Pre-Solicitation (Agile Teams)", "Solicitation", "Evaluation", "Administration"]

"canada_frameworks":
  - "@id": "tbs:ProcurementDirective"
    "name": "Directive on the Management of Procurement"
    "digital_supports":
      - "name": "Unbundling Requirements"
        "description": "Legitimate division of requirements into smaller requirements to permit specialized firms to bid (TBS 4.3.4.5)."
      - "name": "Performance-Based Specs"
        "description": "Specifying requirements in terms of performance and functional requirements rather than design (CFTA 509.2)."
      - "name": "Iterative Approaches"
        "description": "Explicitly promoting outcomes-based and iterative approaches for complex needs (TBS 4.1.2.10)."

"digital_workforce":
  - "name": "FAC-C-Digital Services (USA)"
    "description": "FAI specialization for digital procurement professionals."
  - "name": "DITAP Training"
    "description": "USDS-backed program for agile acquisition specialists."
