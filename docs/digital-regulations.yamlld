"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "far": "https://www.acquisition.gov/far/"
  "tfh": "https://techfarhub.usds.gov/"

"@id": "https://example.org/procurement-digital-regulations"
"@type": "Dataset"
"name": "Digital Procurement Regulations & Agile Frameworks (2026)"
"description": "Mapping of US Federal Acquisition Regulations (FAR), TechFAR Hub, and FAI certifications to agile and modular digital procurement."

"regulatory_frameworks":
  - "@id": "far:Part39"
    "name": "FAR Part 39 - Acquisition of ICT"
    "key_elements":
      - "name": "Modular Contracting"
        "definition": "Acquiring systems in successive, interoperable increments."
      - "name": "Accessibility (Section 508)"
        "description": "Enforceable standards for inclusive design."

"professional_certifications":
  - "@id": "proc:FAC-C-DS"
    "name": "FAC-C-Digital Services (FAC-C-DS)"
    "issuer": "Federal Acquisition Institute (FAI)"
    "description": "Core-Plus specialization for contracting professionals performing digital services procurement."
    "training_program": "DITAP (Digital IT Acquisition Professional)"

"acquisition_lifecycle_agile":
  - "@id": "tfh:lifecycle"
    "name": "TechFAR Hub Agile Lifecycle"
    "phases":
      - "phase": "Pre-Solicitation"
        "focus": "Agile Team formation, Market Research, Requirements Development (Agile Estimator)."
      - "phase": "Solicitation"
        "focus": "Contract Design, Performance-Based Contracting, 8(a) Digital Service Initiative."
      - "phase": "Evaluation"
        "focus": "Technical Evaluation (Demo-based), Price Evaluation (Comparative Analysis)."
      - "phase": "Contract Administration"
        "focus": "Agile Quality Assurance, Terminating Agile Contracts (managing pivot risks)."

"special_initiatives":
  - "name": "8(a) Digital Service Initiative"
    "partner": "USDS & SBA"
    "description": "Low-risk gateway for agencies to buy digital services from small/diverse businesses."

"ditap_alignment":
  - "module": "Module 0: Getting Started"
    "focus": "Professionalization & becoming a change ambassador."
  - "module": "Module 3: How Do You Buy?"
    "focus": "Applying the TechFAR Hub lifecycle and modular contracting techniques."
