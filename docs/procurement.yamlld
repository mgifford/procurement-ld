"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "ditap": "https://github.com/usds/ditap-curriculum-update#"
  "purpose": "https://www.procurementwithpurpose.com#"
  "ocp": "https://www.open-contracting.org#"

"@id": "https://example.org/procurement-mind-map"
"@type": "ConceptScheme"
"name": "Mind Map of Concepts around Fair, Effective, Transparent and Equitable Procurement (2026 Perspective)"
"description": "A comprehensive mapping of modern procurement concepts for government, focusing on purpose, socio-economic impact, outcome-based approaches, and digital transformation."

"resources":
  - "@type": "Book"
    "name": "Procurement with Purpose"
    "author": "Peter Smith & Mark Perera"
    "url": "https://www.procurementwithpurpose.com/"
  - "@type": "Organization"
    "name": "Posterity Global"
    "url": "https://www.posterity.global/"
  - "@type": "Organization"
    "name": "TandemGov"
    "url": "https://www.tandemgov.com/"
  - "@type": "Project"
    "name": "DITAP Curriculum"
    "url": "https://github.com/usds/ditap-curriculum-update/"
  - "@type": "Organization"
    "name": "Open Contracting Partnership"
    "url": "https://www.open-contracting.org/"
  - "@type": "WebSite"
    "name": "PQAR (Procurement Quality Assessment Reference)"
    "url": "https://pqar.org/public/"
  - "@type": "Organization"
    "name": "Graphite"
    "url": "https://www.graphiteconnect.com/"
  - "@type": "WebSite"
    "name": "Teaching Public Service in the Digital Age"
    "url": "https://www.teachingpublicservice.digital/"
  - "@type": "WebSite"
    "name": "The Procurement ClassRoom"
    "url": "https://www.procurementclassroom.com/"
  - "@type": "Organization"
    "name": "The Consultant Global"
    "url": "https://theconsultantglobal.com/"

"core_principles":
  - "@id": "proc:Fairness"
    "name": "Fairness"
    "definition": "Ensuring equal opportunity for all qualified suppliers and avoiding bias."
  - "@id": "proc:Effectiveness"
    "name": "Effectiveness"
    "definition": "Delivering intended outcomes and value for money over the lifecycle."
  - "@id": "proc:Transparency"
    "name": "Transparency"
    "definition": "Openness in processes, data, and decision-making to build public trust."
  - "@id": "proc:Equity"
    "name": "Equity"
    "definition": "Addressing systemic barriers and promoting inclusion of marginalized groups."
  - "@id": "proc:Integrity"
    "name": "Integrity"
    "definition": "Upholding high ethical standards and combating corruption."
  - "@id": "proc:Accountability"
    "name": "Accountability"
    "definition": "Clear responsibility for procurement decisions and spending outcomes."
  - "@id": "proc:Competition"
    "name": "Competition"
    "definition": "Driving innovation and value through a healthy, open marketplace."
  - "@id": "proc:Sustainability"
    "name": "Sustainability"
    "definition": "Meeting needs in a way that benefits society, the economy, and the environment."

"engagement_calling_cards":
  - "name": "Results over Hours"
    "concept": "proc:OutcomeBased"
    "description": "Engaging with procurement based on what is solved, not just effort spent."
  - "name": "Proactive Disclosure"
    "concept": "proc:OpenContracting"
    "description": "Publishing data across the whole cycle to build trust and accountability."
  - "name": "Unbiased RFPs"
    "description": "Removing criteria that secretly favor incumbents to ensure genuine fairness."
  - "name": "Respecting Supplier Time"
    "description": "Designing efficient processes to avoid wasting market resources on unwinnable bids."
  - "name": "Government as Market Shaper"
    "concept": "proc:ShapingEconomies"
    "description": "Using buying power to drive innovation, accessibility, and resilience."

"modern_concepts_2026":
  - "@id": "proc:ShapingEconomies"
    "name": "Government as Market Shaper"
    "description": "Government using its buying power to influence market behavior, drive innovation, and support local economies."
  - "@id": "proc:OutcomeBased"
    "name": "Outcome-Based Procurement"
    "description": "Focusing on clarity of results and problems solved rather than cost or credentials of hours."
  - "@id": "proc:Accessibility"
    "name": "Accessibility as a Driver"
    "description": "Procurement requirements for accessible software shift the industry toward inclusive design."
  - "@id": "proc:SovereignCapability"
    "name": "Sovereign Capability"
    "description": "Reassessing who builds, hosts, and secures critical digital infrastructure."
  - "@id": "proc:SpecialistEcosystems"
    "name": "Specialist Provider Ecosystems"
    "description": "Moving toward smaller, specialist providers rather than large, generalist 'primes'."
  - "@id": "proc:AIProcurement"
    "name": "AI-Augmented Procurement"
    "description": "Using AI for analysis and risk identification while maintaining human oversight."
  - "@id": "proc:AgileProcurement"
    "name": "User-Centered and Agile Procurement"
    "description": "Borrowing techniques from digital product development to make procurement faster."

"ditap_mappings":
  - "ditap_module": "Module 1: Digital Services in the 21st Century Government"
    "mapped_concepts": ["proc:Fairness", "proc:Accessibility", "proc:ShapingEconomies", "proc:Integrity"]
  - "ditap_module": "Module 2: Market Intelligence & Stakeholder Analysis"
    "mapped_concepts": ["proc:Transparency", "proc:AIProcurement", "proc:SpecialistEcosystems", "proc:Competition"]
  - "ditap_module": "Module 3: How Do You Buy?"
    "mapped_concepts": ["proc:AgileProcurement", "proc:Effectiveness", "proc:OutcomeBased", "proc:Accountability"]
  - "ditap_module": "Module 4: Awarding & Administering"
    "mapped_concepts": ["proc:Equity", "proc:Sustainability", "proc:SovereignCapability"]

"outliers_and_emerging":
  - "name": "Intergenerational Well-being"
    "source": "Posterity Global"
  - "name": "Beneficial Ownership Transparency"
    "source": "OCP"
