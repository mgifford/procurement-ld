"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "ditap": "https://github.com/usds/ditap-curriculum-update#"
  "purpose": "https://www.procurementwithpurpose.com#"
  "ocp": "https://www.open-contracting.org#"

"@id": "https://example.org/procurement-mind-map"
"@type": "ConceptScheme"
"name": "Mind Map of Concepts around Fair, Effective, Transparent and Equitable Procurement (2026 Perspective)"

"resources":
  - "@type": "Book"
    "name": "Procurement with Purpose"
    "author": "Peter Smith & Mark Perera"
  - "@type": "Organization"
    "name": "Crown Commercial Service (UK)"
    "url": "https://www.gov.uk/government/organisations/crown-commercial-service"
  - "@type": "Organization"
    "name": "Central Digital and Data Office (UK CDDO)"
    "url": "https://www.gov.uk/government/organisations/central-digital-and-data-office"
  - "@type": "Organization"
    "name": "Posterity Global"
  - "@type": "Project"
    "name": "DITAP Curriculum"
  - "@type": "Organization"
    "name": "Open Contracting Partnership"
  - "@type": "WebSite"
    "name": "TechFAR Hub"

"core_principles":
  - "@id": "proc:Fairness"
    "name": "Fairness"
  - "@id": "proc:Effectiveness"
    "name": "Effectiveness"
  - "@id": "proc:Transparency"
    "name": "Transparency"
  - "@id": "proc:Equity"
    "name": "Equity"
  - "@id": "proc:SocialValue"
    "name": "Social Value"
    "definition": "Requiring procurement to improve the social, environmental, and economic well-being of an area."
    "reference": "Public Services (Social Value) Act 2012 (UK)"
  - "@id": "proc:OutcomeSpecifications"
    "name": "Outcome-Based Specifications"
    "definition": "Focusing on desired business results rather than detailed technical specifications."

"engagement_calling_cards":
  - "name": "Social Value First"
    "concept": "proc:SocialValue"
    "description": "Engaging with the broader impact of a contract on the community."
  - "name": "Results over Hours"
    "concept": "proc:OutcomeBased"
  - "name": "Rules of the Game"
    "description": "Clear, upfront selection criteria and unbiased requirements."

"modern_concepts_2026":
  - "@id": "proc:TCoP"
    "name": "Technology Code of Practice"
    "description": "Criteria to help government design, build, and buy technology."
    "source": "UK CDDO"
  - "@id": "proc:AgileProcurement"
    "name": "Agile & Modular Procurement"
    "description": "Iterative delivery and modular contracting to reduce risk."
  - "@id": "proc:OpenStandards"
    "name": "Open Standards & Open Source"
