"@context":
  "@vocab": "https://schema.org/"
  "proc": "https://example.org/procurement#"
  "ditap": "https://github.com/usds/ditap-curriculum-update#"
  "tbs": "https://www.tbs-sct.canada.ca/"

"@id": "https://example.org/procurement-mind-map"
"@type": "ConceptScheme"
"name": "Mind Map of Concepts around Fair, Effective, Transparent and Equitable Procurement (2026 Perspective)"

"resources":
  - "@type": "Organization"
    "name": "Treasury Board of Canada Secretariat (TBS)"
    "url": "https://www.tbs-sct.canada.ca/"
  - "@type": "Organization"
    "name": "CFTA (Canadian Free Trade Agreement)"
    "url": "https://www.cfta-alec.ca/"
  - "@type": "Organization"
    "name": "USDS TechFAR Hub"
    "url": "https://techfarhub.usds.gov/"

"core_principles":
  - "@id": "proc:Fairness"
    "name": "Fairness"
  - "@id": "proc:Effectiveness"
    "name": "Effectiveness"
  - "@id": "proc:Transparency"
    "name": "Transparency"
  - "@id": "proc:Equity"
    "name": "Equity"
  - "@id": "proc:Unbundling"
    "name": "Unbundling Requirements"
    "definition": "Dividing requirements to permit smaller and more specialized firms to bid."
    "reference": "TBS Directive 4.3.4.5"
  - "@id": "proc:BestValueToCrown"
    "name": "Best Value to the Crown"
    "definition": "Balancing quality and effectiveness with outlay over the period of use, including socio-economic goals."
    "source": "TBS"

"engagement_calling_cards":
  - "name": "Results over Hours"
  - "name": "Indigenous Participation First"
  - "name": "Unbundling for SMEs"
    "concept": "proc:Unbundling"

"modern_concepts_2026":
  - "@id": "proc:ModularContracting"
  - "@id": "proc:IterativeAcquisition"
    "name": "Iterative Acquisition"
    "description": "Using phases, gates, and off-ramps to allow flexibility in complex projects."
    "source": "TBS"
  - "@id": "proc:CanadianValueAdded"
    "name": "Canadian Value-Added"
    "description": "Preference for domestic labor and production in evaluation."
    "source": "CFTA Article 503.4"
